{
  "name": "easygarden-vitrine",
  "version": "1.0.0",
  "description": "Site vitrine Easy Garden - Expertise Paysagère",
  "main": "index.html",
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/assets/css/input.css -o ./dist/css/main.css --minify",
    "build:sitemap": "node scripts/generate-sitemap.js",
    "build:rss": "node scripts/generate-rss.js",
    "build:images": "node scripts/convert-to-webp.js",
    "build:cms": "node scripts/build.js",
    "build": "npm run build:images && npm run build:cms && npm run build:css && npm run build:sitemap && npm run build:rss",
    "watch": "npx tailwindcss -i ./src/assets/css/input.css -o ./dist/css/main.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "cheerio": "^1.2.0",
    "daisyui": "^5.7.37",
    "fs-extra": "^11.3.4",
    "lenis": "^1.3.26",
    "marked": "^18.0.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.3",
    "tailwindcss-animated": "^2.1.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1"
  }
}
